{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml", "package.json", "yarn.lock"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#prepare": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["lib/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["build/**"]
    },
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android",
        "!android/build",
        "src/*.ts",
        "src/*.tsx",
        "example/package.json",
        "example/android",
        "!example/android/.gradle",
        "!example/android/build",
        "!example/android/app/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "cache": false,
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios",
        "src/*.ts",
        "src/*.tsx",
        "example/package.json",
        "example/ios",
        "!example/ios/build",
        "!example/ios/Pods"
      ],
      "outputs": []
    }
  }
}
